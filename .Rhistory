library(vcfR)
library(tidyr)
library(ggplot2)
source("R_scripts/ggplot_theme.txt")
#filtered VCF
vcf <- read.vcfR("data/Nf_SPANDx_all_seqs/out.vcf", verbose = FALSE)
vcf
str(vcf)
vcf@meta
dp <- extract.gt(vcf, element='DP', as.numeric=TRUE)
is.matrix(dp)
#sample_ids
first_set.ids = paste0("NG", 1:99)
second_set.ids = paste0("NG", 101:163)
third_set.ids = paste0("NG", 170:196)
colnames(dp)
sample_ids <- extract.gt(vcf, element='DP', as.numeric=TRUE) %>% colnames()
sample_ids
colnames(vcf)
names(vcf)
str(vcf)
sample_ids[paste0("NG", 1:99)]
paste0("NG", 1:99) %in% sample_ids
#sample_ids
first_set.ids = paste0("NG", 1:99)
second_set.ids = paste0("NG", 101:163)
third_set.ids = paste0("NG", 170:196)
lib_one = first_set.ids[first_set.ids %in% sample_ids]
lib_two = first_set.ids[second_set.ids %in% sample_ids]
lib_three = first_set.ids[third_set.ids %in% sample_ids]
lib_one
lib_two
lib_one = first_set.ids[first_set.ids %in% sample_ids]
lib_two = second_set.ids[second_set.ids %in% sample_ids]
lib_three = third_set.idss[third_set.ids %in% sample_ids]
lib_one
lib_three = third_set.ids[third_set.ids %in% sample_ids]
lib_two
lib_three
write.table(lib_one, "data/Nf/lib_one_ids.txt")
q(save="no")
library(dplyr)
#Nd
blast_res = read.table("data/N_ditissima_ref_genome/Nd_fonseca_mt.blast", header = F)
scf_len = read.table("data/N_ditissima_ref_genome/scaffold_lengths.txt", header = T)
colnames(blast_res) = c(
"contig",
"dbID",
"perc_sim",
"hit_length",
"mismatch",
"gapopen",
"qstart",
"qend",
"sstart",
"send",
"e-val",
"bitscore"
)
colnames(scf_len) = c("contig", "contig_len")
mt_hits = blast_res %>%
group_by(contig) %>%
summarize(tot_hit_len = sum(hit_length), n_hit = n()) %>%
left_join(., scf_len, by = "contig") %>%
mutate(perc_contig = tot_hit_len/contig_len*100)
mt_hits
scf_len
scf_len = read.table("data/N_ditissima_ref_genome/scaffold_lengths.txt", header = F)
colnames(scf_len) = c("contig", "contig_len")
